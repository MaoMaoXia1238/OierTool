/**
 * Prisma 数据库模型定义
 * 定义竞赛数据的表结构和字段约束。
 * 使用 PostgreSQL 作为数据库引擎。
 */

// Prisma Client 生成器
generator client {
  provider = "prisma-client"
  output   = "../../prisma/generated"
}

// 数据源（PostgreSQL）
// 连接字符串已迁移至 prisma.config.ts
// 根据ai回答以下被注释的写法是prismav7的最新写法, 但实际使用时会报错
datasource db {   
  provider = "postgresql"
}

// 竞赛信息表
model Contest {
  id        String   @id @default(cuid())   // 唯一 ID
  name      String                          // 竞赛名称
  platform  String                          // 平台（Codeforces / Luogu）
  startTime DateTime                        // 开始时间
  endTime   DateTime                        // 结束时间
  duration  Int                             // 时长（分钟）
  url       String?                         // 竞赛链接（可选）
  createdAt DateTime @default(now())        // 记录创建时间
  updatedAt DateTime @updatedAt             // 记录更新时间

  @@index([platform])                       // 按平台筛选优化
  @@index([startTime])                      // 按时间排序优化
  @@map("contests")                         // 数据库表名
}

// 用户表 — Auth.js v5 认证
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique                                      // 邮箱唯一
  emailVerified DateTime?                                              // 邮箱验证时间（预留）
  image         String?                                                // 头像 URL（预留）
  password      String?                                                // bcrypt 哈希后的密码
  role          String    @default("USER")                             // USER | ADMIN（预留）
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  @@map("users")
}

// OAuth 账户关联表 — 预留 Google/GitHub 等第三方登录
model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String                                             // oauth / credentials
  provider          String                                             // google / github / ...
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// 会话表 — 数据库 Session 策略（当前使用 JWT，此表预留）
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("sessions")
}

// 邮箱验证 Token 表 — 邮箱验证 + 注册暂存
// pendingData: 注册验证时暂存用户数据（JSON: { password, name }），登录验证码时为 null
model VerificationToken {
  identifier  String
  token       String
  expires     DateTime
  pendingData String?  @db.Text  // 待注册用户的 bcrypt 密码 + 用户名（JSON）
  @@unique([identifier, token])
  @@map("verification_tokens")
}
