# PostgreSQL 数据库连接串
# 本地开发：使用 Docker 容器时端口为 5433（容器名 oiertool-postgres）
#   docker run -d --name oiertool-postgres -e POSTGRES_PASSWORD=postgres \
#     -e POSTGRES_DB=oiertool -p 5433:5432 postgres:18-alpine
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/oiertool

# Auth.js 会话加密密钥（必填，无默认值）
# 生成方式：openssl rand -base64 32
AUTH_SECRET=

# 站点地址（Docker 部署时用于 Auth.js，本地默认为 http://localhost:3000）
# AUTH_URL=http://localhost:3000

# 内部服务间共享密钥（crawler→web 重算回调鉴权）
# 生成方式：openssl rand -hex 32
INTERNAL_API_SECRET=

# crawler→web 内部回调地址（Docker 中为 http://web:3000）
WEB_INTERNAL_URL=http://localhost:3000
