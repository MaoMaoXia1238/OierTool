# PostgreSQL 数据库连接串（与 web/.env 保持一致）
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/oiertool

# 内部服务间共享密钥（与 web/.env 保持一致）
INTERNAL_API_SECRET=

# crawler→web 内部回调地址（本地开发为 http://localhost:3000）
WEB_INTERNAL_URL=http://localhost:3000

